<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysRoleDeptMapper">

	<resultMap type="SysRoleDept" id="SysRoleDeptResult">
		<result property="roleId" jdbcType="BIGINT" column="role_id"/>
		<result property="deptId"  jdbcType="BIGINT" column="dept_id"/>
		<result property="createTime" jdbcType="TIMESTAMP" column="create_time"/>
		<result property="updateTime" jdbcType="TIMESTAMP" column="update_time"/>
	</resultMap>

	<delete id="deleteRoleDeptByRoleId" parameterType="Long">
		DELETE FROM sys_role_dept WHERE role_id = #{roleId,jdbcType=BIGINT}
	</delete>

	<select id="selectCountRoleDeptByDeptId" resultType="java.lang.Integer">
	    SELECT COUNT(*) FROM sys_role_dept WHERE dept_id = #{deptId,jdbcType=BIGINT}
	</select>

	<delete id="deleteRoleDept" parameterType="Long">
 		DELETE FROM sys_role_dept WHERE role_id IN
 		<foreach collection="array" item="roleId" open="(" separator="," close=")">
 			#{roleId,jdbcType=BIGINT}
        </foreach>
 	</delete>

	<insert id="batchRoleDept">
		INSERT INTO sys_role_dept(role_id, dept_id, create_time, update_time) VALUES
		<foreach item="item" index="index" collection="list" separator=",">
			(#{item.roleId,jdbcType=BIGINT}, #{item.deptId,jdbcType=BIGINT}, NOW(), NOW())
		</foreach>
	</insert>

</mapper>